[
  {
    "bucket": "case_unicode_and_separators",
    "name": "camel_nul_is_not_separator",
    "template": "v={{ toCamelCase \"a\\x00B\" | printf \"%q\" }}",
    "want": "v=\"a\\x00b\"",
    "error": false
  },
  {
    "bucket": "case_unicode_and_separators",
    "name": "camel_tab_is_not_separator",
    "template": "v={{ toCamelCase \"a\\tB\" | printf \"%q\" }}",
    "want": "v=\"a\\tb\"",
    "error": false
  },
  {
    "bucket": "case_unicode_and_separators",
    "name": "constant_repeated_separators",
    "template": "v={{ toConstantCase \"a__ B\" | printf \"%q\" }}",
    "want": "v=\"A_B\"",
    "error": false
  },
  {
    "bucket": "case_unicode_and_separators",
    "name": "pascal_combining_mark_consumes_capitalization",
